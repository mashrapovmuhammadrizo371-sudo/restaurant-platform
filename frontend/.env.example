# Leave unset to use the Vite dev proxy (relative /api) — the default local
# setup needs no changes here at all. Set this only when the frontend build
# is served from a different origin than the backend in production.
VITE_API_URL=

# Base URL the Socket.IO client connects to. Leave unset in dev (falls back
# to same-origin, which the dev proxy forwards to the backend). Set to the
# backend's public URL in production if it's a different origin.
VITE_SOCKET_URL=

# Only read by vite.config.js during local development, to know where to
# proxy /api, /uploads and /socket.io to.
VITE_BACKEND_ORIGIN=http://localhost:5000
