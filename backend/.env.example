NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_platform

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# First Boss/Super Admin bootstrap (used only by src/utils/seed.js)
BOSS_LOGIN=boss
BOSS_PASSWORD=change_this_password
BOSS_NAME=Super Admin
